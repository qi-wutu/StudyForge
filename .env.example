# ===== MySQL 连接配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=studyforge

# ===== LLM 大模型配置（OpenAI 兼容协议，任意模型通用） =====
# 本项目用 langchain-openai 的 ChatOpenAI，只要目标模型兼容 OpenAI 协议就能换着用。
# 换任意 provider 只需改 LLM_BASE_URL 和 LLM_MODEL，代码零改动。
#
# 常见 provider 示例（填其中一组即可）：
#   DeepSeek（默认）：  LLM_BASE_URL=https://api.deepseek.com            LLM_MODEL=deepseek-chat
#   通义千问 Qwen：     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱 GLM：          LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-plus
#   Moonshot / Kimi：   LLM_BASE_URL=https://api.moonshot.cn/v1            LLM_MODEL=moonshot-v1-8k
#   MiniMax：           LLM_BASE_URL=https://api.minimax.chat/v1           LLM_MODEL=Minimax-Text-01
#   OpenAI：            LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
